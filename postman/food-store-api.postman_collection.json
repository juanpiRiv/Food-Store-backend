{
  "info": {
    "name": "Food Store API - TP1 Api Rest",
    "description": "Coleccion del Trabajo Practico Api Rest (Programacion IV). Flujo completo: crear 2 usuarios, 3 categorias, 10 productos, 3 pedidos con detalles, actualizar 1 categoria, buscar usuarios por id y por mail, y casos de error. Ejecutar la app con ./mvnw spring-boot:run antes de probar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "1. Crear usuario Ana (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Ana\",\n    \"apellido\": \"Garcia\",\n    \"mail\": \"ana@mail.com\",\n    \"celular\": \"11-5555-0101\",\n    \"contrasena\": \"admin123\",\n    \"rol\": \"ADMIN\"\n}" },
            "url": "{{baseUrl}}/api/usuarios",
            "description": "Punto 5a: crear usuario. Respuesta esperada: 201."
          }
        },
        {
          "name": "2. Crear usuario Carlos (USUARIO)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Carlos\",\n    \"apellido\": \"Perez\",\n    \"mail\": \"carlos@mail.com\",\n    \"celular\": \"11-5555-0202\",\n    \"contrasena\": \"clave123\",\n    \"rol\": \"USUARIO\"\n}" },
            "url": "{{baseUrl}}/api/usuarios",
            "description": "Punto 5a: crear usuario. Respuesta esperada: 201."
          }
        },
        {
          "name": "7. Buscar usuario por id",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}/api/usuarios/1",
            "description": "Punto 7: buscar usuario por id y mostrar informacion por consola. Respuesta esperada: 200 con los datos de Ana."
          }
        },
        {
          "name": "8. Buscar usuario por mail",
          "request": {
            "method": "GET",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}/api/usuarios/mail/carlos@mail.com",
            "description": "Punto 8: buscar usuario por mail y mostrar por consola. Respuesta esperada: 200 con los datos de Carlos."
          }
        },
        {
          "name": "Actualizar usuario 2",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"nombre\": \"Carlitos\",\n    \"apellido\": \"Perez\",\n    \"mail\": \"carlos@mail.com\",\n    \"celular\": \"11-9999-9999\",\n    \"rol\": \"USUARIO\"\n}" },
            "url": "{{baseUrl}}/api/usuarios/2",
            "description": "Actualizacion parcial de usuario: el mail y el rol se conservan. Respuesta esperada: 200."
          }
        }
      ]

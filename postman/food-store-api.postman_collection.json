        {
          "name": "5k. Crear pedido 1 (Ana, 2 detalles)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"usuarioId\": 1,\n    \"estado\": \"CONFIRMADO\",\n    \"formaPago\": \"TARJETA\",\n    \"detalles\": [\n        { \"productoId\": 1, \"cantidad\": 2, \"subtotal\": 17000.0 },\n        { \"productoId\": 6, \"cantidad\": 2, \"subtotal\": 5000.0 }\n    ]\n}" },
            "url": "{{baseUrl}}/api/pedidos",
            "description": "Punto 5b: crear pedido con al menos 2 detalles. Respuesta esperada: 201, total 22000.0. El stock de los productos se descuenta."
          }
